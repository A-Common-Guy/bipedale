<?xml version="1.0"?>
<package format="3">
  <name>sandro_perception</name>
  <version>0.1.0</version>
  <description>Sandro's eyes: the depth camera's images into the terrain profile ahead of each wheel.</description>
  <maintainer email="giuseppe.festa@example.com">Giuseppe Festa</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
