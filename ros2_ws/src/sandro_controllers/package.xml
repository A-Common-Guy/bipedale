<?xml version="1.0"?>
<package format="3">
  <name>sandro_controllers</name>
  <version>0.1.0</version>
  <description>ROS 2 control plugins for the Sandro wheeled biped.</description>
  <maintainer email="giuseppe.festa@example.com">Giuseppe Festa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>controller_interface</depend>
  <depend>diagnostic_msgs</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/sandro_controllers_plugins.xml"/>
  </export>
</package>
