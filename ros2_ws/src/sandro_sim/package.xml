<?xml version="1.0"?>
<package format="3">
  <name>sandro_sim</name>
  <version>0.1.0</version>
  <description>Simulation-side fidelity layer for Sandro: a hardware-interface decorator that adds the sensor and command latency of the physical robot to the MuJoCo backend.</description>
  <maintainer email="giuseppe.festa@example.com">Giuseppe Festa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <exec_depend>mujoco_ros2_control</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/sandro_sim_plugins.xml"/>
  </export>
</package>
